# OpenAI API Key (Required for engine)
OPENAI_API_KEY=your-openai-api-key-here

# Optional/Alternative Anthropic API Key
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model selection (e.g., gpt-4o-mini, gpt-4o)
LLM_MODEL=gpt-4o-mini

# LLM Temperature (0.0 for deterministic grading/analysis, 0.7 for varied questions)
LLM_TEMPERATURE=0.5
